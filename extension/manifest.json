{
  "name": "AllenPlan",
  "description": "Plan future quarters with ease",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "mhtml://*/*",
    "file:///*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["darsScraper.js", "classes.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}

